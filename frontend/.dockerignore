# ============================================================
# frontend/.dockerignore
# ============================================================

# Node dependencies (rebuilt inside the container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# CRA build output (stage 1 generates a fresh one)
build

# Environment files
.env
.env.*
!.env.example

# Development / editor artefacts
.git
.gitignore
.DS_Store
Thumbs.db
*.log

# Test files
coverage
**/*.test.js
**/*.test.jsx
**/*.spec.js
**/*.spec.jsx
__tests__

# Docker files
Dockerfile
.dockerignore
docker-compose*.yml

# Documentation
README.md
*.md
